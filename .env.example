## ONECARE Environment Template
# Copy this file to `.env` (Git-ignored) and populate secrets from Vault/1Password.
# Do NOT commit populated .env files. See docs/SECURITY.md and docs/ML_ENV.md for details.

### Core orchestrator + local runtime
NODE_ENV=development
PRACTICE_ID=demo
PORT=3001
PORT_ORCHESTRATOR=3001
LOG_LEVEL=info
ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ORCHESTRATOR_ALLOW_LOOPBACK_UPSTREAMS=1
BUS_IMPL=memory
BUS_HEALTH_CACHE_MS=2000
BUS_READY_PENDING_LAG=200

### Local ML services
PY_SAFETY_GATE_URL=http://localhost:8081
PY_SAFETY_GATE_HOST_ALLOWLIST=localhost,127.0.0.1,safety-gate
PY_SAFETY_GATE_API_KEY=dev-safety-key
PY_SCRIBE_URL=http://localhost:8082

### Frontend integration
VITE_ORCH_URL=http://localhost:3001
VITE_BOOKING_API_URL=http://localhost:3001

### Booking upstreams (set when enabling booking APIs)
BOOKING_AVAILABILITY_URL=
BOOKING_SERVICE_URL=

### FHIR / upstream APIs
FHIR_BASE_URL=https://fhir-dev.example.com
FHIR_TOKEN=REPLACE_WITH_FHIR_PATIENT_TOKEN
FHIR_SYSTEM_TOKEN=REPLACE_WITH_FHIR_SYSTEM_TOKEN
FHIR_AUTH_TOKEN=REPLACE_WITH_FHIR_PATIENT_TOKEN
FHIR_CLIENT_ID=REPLACE_WITH_FHIR_CLIENT_ID
FHIR_CLIENT_SECRET=REPLACE_WITH_FHIR_CLIENT_SECRET
FHIR_API_KEY=REPLACE_WITH_NHS_API_KEY
NHS_API_KEY=REPLACE_WITH_NHS_API_KEY
FHIR_API_KEY_HEADER=Ocp-Apim-Subscription-Key
FHIR_TIMEOUT_MS=2000
FHIR_MAX_RETRIES=2
FHIR_HEALTH_PATH=metadata

### Object store (optional)
OBJECT_STORE_BASE_URL=
OBJECT_STORE_TOKEN=
OBJECT_STORE_AUTH_TOKEN=
OBJECT_STORE_TIMEOUT_MS=2000
OBJECT_STORE_MAX_RETRIES=1
OBJECT_STORE_HEALTH_PATH=health

### Messaging (set when BUS_IMPL != memory)
NATS_URL=tls://localhost:4222
NATS_USER=onecare-dev
NATS_PASS=REPLACE_WITH_NATS_PASSWORD
NATS_TOKEN=
NATS_CONNECT_TIMEOUT_MS=2000
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_BASE_DELAY_MS=250
NATS_RECONNECT_MAX_DELAY_MS=8000
NATS_RECONNECT_JITTER_RATIO=0.2
NATS_RECONNECT_TIME_WAIT_MS=1500
NATS_TLS_ENABLED=1
NATS_TLS_REQUIRED=1
NATS_TLS_CA_PATH=infra/tls/dev/ca.crt
NATS_TLS_CERT_PATH=infra/tls/dev/client.crt
NATS_TLS_KEY_PATH=infra/tls/dev/client.key

### LLM / guided help
GUIDED_HELP_LLM_MODE=stub
LLM_MODEL=gpt-4o
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_API_ENDPOINT=https://api.openai.com/v1

### Zero-trust auth + consent (portal, guided-help)
# Keep SECURITY_SHARED_SECRET and VITE_SECURITY_SHARED_SECRET identical so portal signatures validate (avoids signature_invalid on /safety-check).
SECURITY_SHARED_SECRET=dev-shared-secret
SECURITY_REPLAY_WINDOW_MS=1000
SECURITY_SYSTEM_ALLOWLIST=
CONSENT_CACHE={"patient-123":[{"purpose":"care","resources":["GuidedHelpSession","QuestionnaireResponse","Communication","Slot"],"reference":"Consent/patient-123-care","grantedAt":"2024-01-01T00:00:00Z","expiresAt":"2030-01-01T00:00:00Z"}],"demo-patient":[{"purpose":"care","resources":["GuidedHelpSession","QuestionnaireResponse","Communication","Slot"],"reference":"Consent/demo-patient-care","grantedAt":"2024-01-01T00:00:00Z","expiresAt":"2030-01-01T00:00:00Z"}]}
VITE_SECURITY_SHARED_SECRET=dev-shared-secret

### OIDC (optional)
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_TIMEOUT_MS=2000
OIDC_CLOCK_SKEW_SECONDS=60

### Observability (OpenTelemetry)
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=REPLACE_WITH_OTEL_EXPORTER_KEY
OTEL_RESOURCE_ATTRIBUTES=service.name=onecare-orchestrator,environment=development

### Feature logging & drift monitoring
FEATURE_LOGGING=0
FEATURE_LOG_ENDPOINT=http://localhost:3001/feature-log
FEATURE_LOG_BEARER_TOKEN=
FEATURE_LOG_API_KEY=
FEATURE_DRIFT_MONITORING=0
FEATURE_DRIFT_BASELINE_SIZE=200
FEATURE_DRIFT_CURRENT_SIZE=50
FEATURE_DRIFT_PSI_THRESHOLD=0.5
FEATURE_DRIFT_MEAN_THRESHOLD=0.3
FEATURE_DRIFT_STD_THRESHOLD=0.3

### Orchestrator guardrails (optional overrides)
ORCHESTRATOR_MAX_CONCURRENCY_GLOBAL=64
ORCHESTRATOR_MAX_CONCURRENCY_DEFAULT=32
ORCHESTRATOR_MAX_CONCURRENCY_SAFETY=24
ORCHESTRATOR_MAX_CONCURRENCY_BOOKING=16
ORCHESTRATOR_MAX_CONCURRENCY_FEATURE_LOG=12
ORCHESTRATOR_MAX_CONCURRENCY_GUIDED_HELP=24
ORCHESTRATOR_RATE_LIMIT_DEFAULT_PER_MINUTE=120
ORCHESTRATOR_RATE_LIMIT_SAFETY_PER_MINUTE=40
ORCHESTRATOR_RATE_LIMIT_GUIDED_HELP_PER_MINUTE=60
ORCHESTRATOR_RATE_LIMIT_WINDOW_MS=60000
ORCHESTRATOR_RATE_LIMIT_BLOCK_MS=10000
ORCHESTRATOR_RATE_LIMIT_SAFETY_WINDOW_MS=60000
ORCHESTRATOR_RATE_LIMIT_SAFETY_BLOCK_MS=20000
ORCHESTRATOR_RATE_LIMIT_GUIDED_HELP_WINDOW_MS=60000
ORCHESTRATOR_RATE_LIMIT_GUIDED_HELP_BLOCK_MS=10000
ORCHESTRATOR_BUS_PUBLISH_TIMEOUT_MS=500
ORCHESTRATOR_BUS_PUBLISH_MAX_RETRIES=2
ORCHESTRATOR_BUS_PUBLISH_BACKOFF_MS=50
ORCHESTRATOR_SHUTDOWN_DRAIN_TIMEOUT_MS=10000
MAX_BODY_BYTES=256kb

### Safety Gate ML service
SAFETY_GATE_PORT=8081
SAFETY_MODEL_PATH=/models/safety/latest
SAFETY_THRESHOLD=0.65
SAFETY_RULESET_ID=dev-default
SAFETY_MAX_TIMEOUT_MS=1500
SAFETY_GATE_API_KEY=dev-safety-key
SAFETY_SERVICE_API_KEY=REPLACE_WITH_SAFETY_API_KEY

### Scribe ML service
SCRIBE_PORT=8082
SCRIBE_ASR_PROVIDER=whisper
SCRIBE_ASR_API_KEY=REPLACE_WITH_ASR_API_KEY
SCRIBE_LLM_PROVIDER=openai
SCRIBE_LLM_MODEL=gpt-4o
SCRIBE_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
SCRIBE_LLM_ENDPOINT=https://api.openai.com/v1
SCRIBE_REQUEST_TIMEOUT_MS=10000
SCRIBE_SUMMARY_MAX_TOKENS=2048
SCRIBE_FALLBACK_MODE=transcript

### Feature view materialiser (scripts/feature_store/views.js)
FEATURE_VIEW_NAME=triage-core.sliding-windows
FEATURE_VIEW_ONLINE_TTL_SECONDS=3600
FEATURE_VIEW_PARTITION_ROOT=

### Legacy mock/demo credentials (not used by runtime)
NHS_API_SECRET=REPLACE_WITH_NHS_API_SECRET
NHS_LOGIN_CLIENT_ID=
NHS_LOGIN_CLIENT_SECRET=
NHS_LOGIN_REDIRECT_URI=
NHS_LOGIN_AUTH_CODE=
NHS_LOGIN_KEYCLOAK_ACCESS_TOKEN=
NHS_LOGIN_ID_TOKEN=
NHS_OIDC_CLIENT_ID=
NHS_OIDC_CLIENT_SECRET=
NHS_OIDC_REDIRECT_URI=
