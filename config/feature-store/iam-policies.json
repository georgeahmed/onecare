{
  "feature-ingest": {
    "description": "Write feature events from ingestion worker to the online store and DLQ.",
    "policyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "IngestWriteHot",
          "Effect": "Allow",
          "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem"],
          "Resource": ["arn:aws:dynamodb:us-west-2:123456789012:table/feature-hot-prod"]
        },
        {
          "Sid": "PublishDlq",
          "Effect": "Allow",
          "Action": ["sqs:SendMessage"],
          "Resource": ["arn:aws:sqs:us-west-2:123456789012:feature-ingest-dlq-prod"]
        },
        {
          "Sid": "DescribeTables",
          "Effect": "Allow",
          "Action": ["dynamodb:DescribeTable"],
          "Resource": ["arn:aws:dynamodb:us-west-2:123456789012:table/feature-hot-prod"]
        }
      ]
    }
  },
  "feature-reader": {
    "description": "Read-only access for serving path (online store).",
    "policyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ReadHot",
          "Effect": "Allow",
          "Action": ["dynamodb:GetItem", "dynamodb:BatchGetItem"],
          "Resource": ["arn:aws:dynamodb:us-west-2:123456789012:table/feature-hot-prod"],
          "Condition": {
            "Bool": { "aws:SecureTransport": "true" }
          }
        }
      ]
    }
  },
  "feature-offline-writer": {
    "description": "Write/compact permissions for offline parquet buckets (no hot-store access).",
    "policyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "WriteWarm",
          "Effect": "Allow",
          "Action": ["s3:PutObject", "s3:DeleteObject"],
          "Resource": ["arn:aws:s3:::onecare-feature-warm-prod/offline/*"]
        },
        {
          "Sid": "ListWarm",
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::onecare-feature-warm-prod"],
          "Condition": {
            "StringLike": { "s3:prefix": ["offline/*"] }
          }
        },
        {
          "Sid": "WarmKms",
          "Effect": "Allow",
          "Action": ["kms:GenerateDataKey", "kms:Encrypt", "kms:Decrypt"],
          "Resource": ["arn:aws:kms:us-west-2:123456789012:key/alias/feature-warm-prod"]
        }
      ]
    }
  },
  "feature-audit-readonly": {
    "description": "Break-glass audit role; requires MFA.",
    "sessionPolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ReadAllTiers",
          "Effect": "Allow",
          "Action": ["dynamodb:GetItem", "dynamodb:Scan", "s3:GetObject", "s3:ListBucket"],
          "Resource": [
            "arn:aws:dynamodb:us-west-2:123456789012:table/feature-hot-prod",
            "arn:aws:s3:::onecare-feature-warm-prod",
            "arn:aws:s3:::onecare-feature-warm-prod/*",
            "arn:aws:s3:::onecare-feature-cold-prod",
            "arn:aws:s3:::onecare-feature-cold-prod/*"
          ],
          "Condition": {
            "Bool": { "aws:MultiFactorAuthPresent": "true" }
          }
        },
        {
          "Sid": "DecryptAll",
          "Effect": "Allow",
          "Action": ["kms:Decrypt"],
          "Resource": [
            "arn:aws:kms:us-west-2:123456789012:key/alias/feature-hot-prod",
            "arn:aws:kms:us-west-2:123456789012:key/alias/feature-warm-prod",
            "arn:aws:kms:us-west-2:123456789012:key/alias/feature-cold-prod"
          ],
          "Condition": {
            "Bool": { "aws:MultiFactorAuthPresent": "true" }
          }
        }
      ]
    }
  }
}
