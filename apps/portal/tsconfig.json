{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "emitDeclarationOnly": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "src/config/accessibility.defaults.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
