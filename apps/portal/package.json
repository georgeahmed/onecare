{
  "name": "@onecare/app-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "a11y:ci": "tsx scripts/a11y-ci.ts",
    "i18n:extract": "tsx scripts/i18n/extract.ts",
    "i18n:check": "tsx scripts/i18n/extract.ts --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "preview:e2e": "npm run build && VITE_ORCH_URL=http://localhost:3001 vite preview --port=5173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@onecare/events": "file:../../packages/events",
    "react": "^18.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^7.1.14",
    "react-router-dom": "^6.22.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/pa11y": "^5.3.7",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.2.1",
    "axe-core": "^4.11.0",
    "eslint": "^8.57.0",
    "jsdom": "^27.0.0",
    "json-schema-to-typescript": "^13.1.2",
    "pa11y": "^9.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
