# See ../../docs/ML_ENV.md for a complete description of each setting.
PORT=3001
BUS_IMPL=nats
NATS_URL=nats://onecare:onecare-secret@nats:4222
NATS_USER=onecare
NATS_PASS=onecare-secret
NATS_CONNECT_TIMEOUT_MS=2000
NATS_MAX_RECONNECT_ATTEMPTS=10
PY_SAFETY_GATE_URL=http://safety-gate:8081
PY_SCRIBE_URL=http://scribe:8082
OTEL_ENABLED=0
FEATURE_LOGGING=0
FEATURE_DRIFT_MONITORING=0
FEATURE_DRIFT_BASELINE_SIZE=200
FEATURE_DRIFT_CURRENT_SIZE=50
FEATURE_DRIFT_PSI_THRESHOLD=0.5
FEATURE_DRIFT_MEAN_THRESHOLD=0.3
FEATURE_DRIFT_STD_THRESHOLD=0.3
