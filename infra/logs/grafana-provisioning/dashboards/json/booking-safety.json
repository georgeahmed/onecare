      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(booking_http_duration_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "booking p95",
          "refId": "A"
        }
      ],
      "title": "Booking latency p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "req/s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "hidden" }
      },
      "targets": [
        {
          "expr": "rate(booking_http_backpressure_total[$__rate_interval])",
          "legendFormat": "backpressure",
          "refId": "A"
        }
      ],
      "title": "Booking backpressure rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "hidden" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(safety_gate_request_latency_seconds_bucket{endpoint=\"analyze\"}[$__rate_interval])) by (le))",
          "legendFormat": "safety gate p95",
          "refId": "A"
        }
      ],
      "title": "Safety Gate latency p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "hidden" }
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(booking_http_requests_total{status=~\"5..\"}[$__rate_interval])) / max(sum(rate(booking_http_requests_total[$__rate_interval])), 1))",
          "legendFormat": "booking errors",
          "refId": "A"
        }
      ],
      "title": "Booking error rate",
      "type": "timeseries"
    }
