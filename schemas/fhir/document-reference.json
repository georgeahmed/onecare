{
  "$id": "https://onecare/schemas/fhir/document-reference.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FHIR DocumentReference (minimal)",
  "type": "object",
  "required": ["resourceType", "status", "content"],
  "properties": {
    "resourceType": {
      "const": "DocumentReference"
    },
    "status": {
      "type": "string",
      "enum": ["current", "superseded", "entered-in-error"]
    },
    "subject": {
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attachment"],
        "properties": {
          "attachment": {
            "type": "object",
            "required": ["url", "contentType"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "contentType": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
