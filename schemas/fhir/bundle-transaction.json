{
  "$id": "https://onecare/schemas/fhir/bundle-transaction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FHIR Transaction Bundle",
  "type": "object",
  "required": ["resourceType", "type", "entry"],
  "properties": {
    "resourceType": {
      "const": "Bundle"
    },
    "type": {
      "const": "transaction"
    },
    "entry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fullUrl", "request", "resource"],
        "properties": {
          "fullUrl": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "request": {
            "type": "object",
            "required": ["method", "url"],
            "properties": {
              "method": {
                "enum": ["POST", "PUT"]
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "resource": {
            "$ref": "bundle-entry-resource.json"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
