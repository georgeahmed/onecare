{
  "$id": "https://onecare/schemas/fhir/communication.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FHIR Communication (minimal)",
  "type": "object",
  "required": ["resourceType", "status"],
  "properties": {
    "resourceType": {
      "const": "Communication"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "in-progress", "entered-in-error"]
    },
    "topic": {
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "medium": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentString": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "note": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
