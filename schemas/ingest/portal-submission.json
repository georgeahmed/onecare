{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecare/schemas/ingest/portal-submission.json",
  "title": "PortalSubmission",
  "type": "object",
  "properties": {
    "practiceId": { "type": "string" },
    "patient": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "locale": { "type": "string" }
      },
      "required": ["id"]
    },
    "narrative": { "type": "string" },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentType": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["contentType", "url"]
      }
    },
    "channel": { "type": "string", "enum": ["web", "ivr"] }
  },
  "required": ["practiceId", "patient", "narrative", "channel"],
  "additionalProperties": false
}

