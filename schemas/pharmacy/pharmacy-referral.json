{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecare/schemas/pharmacy/pharmacy-referral.json",
  "title": "PharmacyReferral",
  "type": "object",
  "properties": {
    "patientId": { "type": "string", "minLength": 1 },
    "condition": { "type": "string", "minLength": 1 },
    "pharmacyOrg": { "type": "string", "minLength": 1 },
    "patientAgeYears": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "patientSex": {
      "type": ["string", "null"],
      "enum": ["female", "male", "other", "unknown", null]
    },
    "severity": { "type": ["string", "null"], "minLength": 1 },
    "exclusionFlags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "slot": {
      "type": ["object", "null"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "locationOdsCode": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    }
  },
  "required": ["patientId", "condition", "pharmacyOrg"],
  "additionalProperties": false
}
