{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecare/schemas/common/error-envelope.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "title": "ErrorObject",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "title": "ErrorEnvelopeCode",
          "enum": [
            "unauthorized",
            "forbidden",
            "invalid_input",
            "not_found",
            "unsupported_media_type",
            "payload_too_large",
            "conflict",
            "upstream_timeout",
            "upstream_unavailable",
            "internal_error",
            "too_many_requests",
            "rate_limited",
            "busy",
            "over_capacity",
            "invalid_fhir"
          ]
        },
        "message": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true },
        "correlationId": { "type": "string" }
      },
      "required": ["code", "message" ]
    }
  },
  "required": ["error"]
}
