{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://onecare/schemas/telephony/call-transcribed/2025-02-16",
  "title": "CallTranscribed",
  "type": "object",
  "properties": {
    "callId": { "type": "string", "minLength": 1 },
