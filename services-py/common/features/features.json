{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecare/features/acuity/v1",
  "title": "AcuityFeatures",
  "description": "Feature contract used by the safety gate acuity model.",
  "type": "object",
  "properties": {
    "symptom_embedding": {
      "type": "array",
      "description": "Fixed length embedding derived from symptom tokens (normalized).",
      "items": { "type": "number" },
      "minItems": 8,
      "maxItems": 8
    },
    "age_years": {
      "type": "number",
      "description": "Patient age in years (clamped to [0, 120]).",
      "minimum": 0,
      "maximum": 120
    },
    "comorbidity_flags": {
      "type": "object",
      "description": "Boolean comorbidity indicators",
      "properties": {
        "diabetes": { "type": "boolean" },
        "cardiac": { "type": "boolean" },
        "respiratory": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "required": ["symptom_embedding", "age_years", "comorbidity_flags"],
  "additionalProperties": false
}
